rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Each user has { role, shopId? } — source of truth for permissions
    match /users/{uid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isControlAdmin());
      allow create: if isControlAdmin()
        || (
          isShopOwner(request.resource.data.shopId)
          && request.resource.data.role == 'staff'
          && request.resource.data.keys().hasAll(['role', 'shopId', 'email', 'displayName', 'createdAt'])
        )
        || (
          // Owner migrating their own account to a new uid (self email change)
          isShopOwner(request.resource.data.shopId)
          && request.resource.data.role == 'customer'
          && request.resource.data.keys().hasAll(['role', 'shopId', 'email', 'createdAt'])
        );
      allow update: if isControlAdmin()
        || (
          isShopOwner(resource.data.shopId)
          && resource.data.role == 'staff'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        )
        || (
          // Self-service: any user may set their own profile photo.
          request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileUrl', 'updatedAt'])
        );
      allow delete: if isControlAdmin()
        || (
          isShopOwner(resource.data.shopId)
          && resource.data.role == 'staff'
        )
        || (
          // Owner deleting their own old doc after an email change
          uid == request.auth.uid
          && resource.data.role == 'customer'
        );
    }

    // ── Customers (personal info, control panel only) ─────────────────────
    match /customers/{customerId} {
      allow read:   if isControlAdmin();
      allow create: if isControlAdmin();
      allow update: if isControlAdmin();
      allow delete: if isControlAdmin();

      match /payments/{paymentId} {
        allow read:   if isControlAdmin();
        allow create: if isControlAdmin();
        allow update: if isControlAdmin();
        allow delete: if isControlAdmin();
      }
    }

    // ── Packages (Control Panel only) ────────────────────────────────────
    match /packages/{packageId} {
      allow read:   if isControlAdmin();
      allow create: if isControlAdmin();
      allow update: if isControlAdmin();
      allow delete: if isControlAdmin();
    }

    // ── Tenants (Control Panel) ───────────────────────────────────────────
    match /tenants/{tenantId} {
      allow read: if isControlAdmin() || isShopMember(tenantId);
      allow write: if isControlAdmin();

      match /invoices/{invoiceId} {
        allow read: if isControlAdmin();
        allow write: if isControlAdmin();
      }
    }

    // ── Shops ─────────────────────────────────────────────────────────────
    // Every write below (except pure control-admin actions) also requires
    // isTenantActive(shopId) — a shop that's suspended/cancelled/expired can
    // still be READ (so an owner can view/export their own history) but
    // can't keep recording sales, adding products, etc. Reads stay open on
    // purpose; only the "keep running the business" actions are gated.
    // This closes the gap where the app's own "blocked" screen was a
    // client-side-only check that anyone talking to Firestore directly
    // (bypassing the app) could ignore.
    match /shops/{shopId} {
      // Any authenticated session — including an anonymous customer viewing
      // a public /order/... menu — may read a shop's basic profile. Nothing
      // sensitive lives on this doc; tenant/billing data stays gated in
      // tenants/{shopId}.
      allow read: if isAnyAuthed();
      allow create, delete: if isControlAdmin();
      allow update: if isControlAdmin() || (isTenantActive(shopId) && (
        (
          isShopOwner(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'profileUrl', 'updatedAt'])
          && request.resource.data.name is string
          && (
            !('profileUrl' in request.resource.data)
            || request.resource.data.profileUrl is string
          )
        )
        // Table roster + zones + service charge + exchange rates — settings
        // behind "ເລືອກໂຕະ" and its "ຈັດການໂຕະ" / "ຈັດການໂຊນ" pages, plus the
        // money-at-checkout "ອັດຕາແລກປ່ຽນ" settings (gated the same as
        // service charge, not canManageProducts, since staff taking orders
        // are the ones who'd apply it).
        || (
          (isShopOwner(shopId) || hasStaffPermission(shopId, 'canTakeOrders'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tableRoster', 'tableZones', 'serviceCharge', 'exchangeRates', 'updatedAt'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tableRoster'])
            || request.resource.data.tableRoster is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tableZones'])
            || request.resource.data.tableZones is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['serviceCharge'])
            || request.resource.data.serviceCharge is map
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['exchangeRates'])
            || request.resource.data.exchangeRates is list
          )
        )
        // Toppings + serving units + food groups + sizes — menu-configuration,
        // so gated like managing products rather than table/zone setup.
        || (
          (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['toppings', 'units', 'foodGroups', 'sizes', 'updatedAt'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['toppings'])
            || request.resource.data.toppings is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['units'])
            || request.resource.data.units is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['foodGroups'])
            || request.resource.data.foodGroups is list
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sizes'])
            || request.resource.data.sizes is list
          )
        )
      ));

      match /products/{productId} {
        // Public menu read (see shops/{shopId} above — same reasoning).
        allow read:   if isAnyAuthed();
        allow create: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'));
        // Selling (recordSale) and cancelling/editing a sale (deleteSale,
        // removeItemFromSale) adjust product stock as part of their
        // transaction even though neither action is "managing products" —
        // any shop member may update ONLY `variants` (stock) for that;
        // changing name/price/cost/photo/category still needs
        // canManageProducts.
        allow update: if isTenantActive(shopId) && (
          isShopOwner(shopId)
          || hasStaffPermission(shopId, 'canManageProducts')
          || (isShopMember(shopId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variants']))
        );
        allow delete: if isTenantActive(shopId) && isShopOwner(shopId);
      }

      // A per-visit QR/barcode token. Staff open one per table (or the app
      // reuses an already-open one); the public /order/... page resolves its
      // `code` to confirm the table is still open before letting a customer
      // submit anything. Closing the bill flips status to "closed", which
      // the sales create rule below checks — the code stops working the
      // instant that happens.
      match /tableSessions/{sessionId} {
        allow read:           if isAnyAuthed();
        allow create, update: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canTakeOrders'));
        allow delete:         if false;
      }

      match /sales/{saleId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        // Three ways a sale doc can be created:
        //  - validSale: instant-checkout (Sell.tsx), paid immediately.
        //  - validOrder by staff: dine-in order taken on the customer's behalf.
        //  - validOrder by anyone holding a currently-open table session's
        //    code: the public QR ordering page — no shop membership required,
        //    gated instead on sessionIsOpen() so a closed-out table can't
        //    receive new charges even if someone replays the old QR image.
        allow create: if isTenantActive(shopId) && (
          (isShopMember(shopId) && validSale(request.resource.data))
          || (isShopMember(shopId) && validOrder(request.resource.data) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canTakeOrders')))
          || (
            isAnyAuthed()
            && validOrder(request.resource.data)
            && 'tableSessionId' in request.resource.data
            && sessionIsOpen(shopId, request.resource.data.tableSessionId)
          )
        );
        // Every allowed update touches a distinct, narrow field set — mirrors
        // the UI gates exactly, and each stage of the dine-in lifecycle can
        // only ever move forward one step, never skip ahead or backward.
        allow update: if isControlAdmin() || (isTenantActive(shopId) && (
          // Price edit / split-price / partial item removal (SalesHistory)
          (
            (isShopOwner(shopId) || (isShopMember(shopId) && (hasStaffPermission(shopId, 'canEditCartPrice') || hasStaffPermission(shopId, 'canDeleteSales'))))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'total'])
            && request.resource.data.total is number
            && request.resource.data.total >= 0
          )
          // Kitchen: pending -> cooking -> ready
          || (
            (isShopOwner(shopId) || hasStaffPermission(shopId, 'canCook'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              (resource.data.status == 'pending' && request.resource.data.status == 'cooking')
              || (resource.data.status == 'cooking' && request.resource.data.status == 'ready')
            )
          )
          // Expedite: ready -> served
          || (
            (isShopOwner(shopId) || hasStaffPermission(shopId, 'canExpedite'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'servedAt'])
            && resource.data.status == 'ready' && request.resource.data.status == 'served'
          )
          // Close bill: served -> paid (records the payment). May also fold a
          // service-charge line item into `items`/`total` on exactly one of
          // the table's tickets at the same time (see closeBill()).
          || (
            (isShopOwner(shopId) || hasStaffPermission(shopId, 'canTakeOrders'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paymentType', 'paidAt', 'items', 'total'])
            && resource.data.status != 'paid' && request.resource.data.status == 'paid'
            && request.resource.data.paymentType in ['cash', 'qr']
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total'])
              || (request.resource.data.total is number && request.resource.data.total >= 0)
            )
          )
          // ຍົກເລີກບິນ (cancelSale): any state -> cancelled, unpaid or
          // already-paid alike — same authority as the old hard-delete
          // (canDeleteSales) since this replaces it, just soft.
          || (
            (isShopOwner(shopId) || hasStaffPermission(shopId, 'canDeleteSales'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'cancelledAt', 'cancelledByUid', 'cancelledByName'])
            && resource.data.status != 'cancelled' && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelReason is string
          )
        ));
        allow delete: if isControlAdmin()
          || (isTenantActive(shopId) && (
            isShopOwner(shopId)
            || (isShopMember(shopId) && hasStaffPermission(shopId, 'canDeleteSales'))
          ));
      }

      match /expenses/{expenseId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'));
      }

      match /expenseCategories/{categoryId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.name is string;
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.name is string;
        allow delete: if isTenantActive(shopId) && isShopOwner(shopId);
      }

      match /incomes/{incomeId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount', 'paymentType', 'createdAt'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.paymentType in ['cash', 'transfer'];
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'))
          && request.resource.data.keys().hasAll(['description', 'amount', 'paymentType'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canAddExpenses'));
      }

      match /categories/{categoryId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && request.resource.data.keys().hasAll(['name'])
          && request.resource.data.name is string
          && (!('foodGroup' in request.resource.data) || request.resource.data.foodGroup is string)
          && (!('icon' in request.resource.data) || request.resource.data.icon is string);
        allow update: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && request.resource.data.name is string
          && (!('icon' in request.resource.data) || request.resource.data.icon is string)
          && (!('foodGroup' in request.resource.data) || request.resource.data.foodGroup is string);
        allow delete: if isTenantActive(shopId) && isShopOwner(shopId);
      }

      // Customer records — `customerId` (the doc id) always equals the
      // customer's own `phone` field (8-digit member code, see
      // customerRepository.ts), so create enforces that match instead of
      // letting a client pick an arbitrary id. Any shop member can add/edit
      // (looked up during daily order-taking); delete stays owner-only,
      // same restriction as categories.
      match /customers/{customerId} {
        allow read: if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId) && isShopMember(shopId)
          && customerId == request.resource.data.phone
          && request.resource.data.phone is string
          && request.resource.data.phone.matches('^[0-9]{8}$')
          && request.resource.data.name is string
          && request.resource.data.enabled is bool
          && (!('address' in request.resource.data) || request.resource.data.address is string);
        allow update: if isTenantActive(shopId) && isShopMember(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'enabled', 'address'])
          && request.resource.data.name is string
          && request.resource.data.enabled is bool
          && (!('address' in request.resource.data) || request.resource.data.address is string);
        allow delete: if isTenantActive(shopId) && isShopOwner(shopId);
      }

      match /bundles/{bundleId} {
        allow read:           if isControlAdmin() || isShopMember(shopId);
        allow create, update: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'));
        allow delete:         if isTenantActive(shopId) && isShopOwner(shopId);
      }

      match /returns/{returnId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId)
          && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'))
          && validReturn(request.resource.data);
        allow update: if false;
        allow delete: if isControlAdmin()
          || (isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts')));
      }

      match /users/{uid} {
        allow read:  if isControlAdmin() || isShopMember(shopId);
        allow write: if isControlAdmin() || (isTenantActive(shopId) && isShopOwner(shopId));
        // Self-service: any shop member may set their own profile photo on
        // their own nested record (the denormalized copy the staff list reads).
        // Not gated on tenant status — a harmless personal action, not "running
        // the business."
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['profileUrl', 'updatedAt']);
      }

      match /transfers/{transferId} {
        allow read:   if isControlAdmin() || isShopMember(shopId);
        allow create: if isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts'));
        allow update: if false;
        allow delete: if isControlAdmin()
          || (isTenantActive(shopId) && (isShopOwner(shopId) || hasStaffPermission(shopId, 'canManageProducts')));
      }
    }

    // ── Helpers ───────────────────────────────────────────────────────────

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Covers regular staff/owner logins AND Firebase anonymous auth sessions
    // (the public QR ordering page signs in anonymously specifically so this
    // is true for it) — deliberately NOT scoped to any shop.
    function isAnyAuthed() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return request.auth != null && getUserData().role == 'superadmin';
    }

    function isControlAdmin() {
      return request.auth != null
        && getUserData().role in ['superadmin', 'admin'];
    }

    function isShopMember(shopId) {
      let d = getUserData();
      return request.auth != null
        && (d.shopId == shopId || (d.keys().hasAny(['shopIds']) && d.shopIds.hasAny([shopId])))
        && d.role in ['customer', 'staff'];
    }

    function isShopOwner(shopId) {
      let d = getUserData();
      return request.auth != null
        && (d.shopId == shopId || (d.keys().hasAny(['shopIds']) && d.shopIds.hasAny([shopId])))
        && d.role == 'customer';
    }

    function hasStaffPermission(shopId, key) {
      return request.auth != null
        && exists(/databases/$(database)/documents/shops/$(shopId)/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.permissions[key] == true;
    }

    // Mirrors parseTenant() in AuthContext.tsx: blocked if status is
    // suspended/cancelled, or if the relevant expiry timestamp
    // (trialEndsAt for trial, expiresAt otherwise) has passed. A tenant with
    // no expiry field at all (e.g. an unlimited plan) is never expired on
    // that basis. If the tenant doc is missing entirely, fail OPEN (treat as
    // active) — matches the client's own default in AuthContext.tsx, so a
    // shop that for some reason has no tenants/{shopId} doc doesn't get
    // silently locked out of every write.
    function isTenantActive(shopId) {
      let path = /databases/$(database)/documents/tenants/$(shopId);
      return !exists(path) || tenantNotExpired(get(path).data);
    }

    function tenantNotExpired(t) {
      let expiry = t.status == 'trial' && ('trialEndsAt' in t)
        ? t.trialEndsAt
        : (('expiresAt' in t) ? t.expiresAt : null);
      return t.status != 'suspended' && t.status != 'cancelled'
        && (expiry == null || expiry > request.time);
    }

    function validSale(data) {
      return data.keys().hasAll(['items', 'total', 'paymentType', 'createdAt'])
        && data.total is number
        && data.total > 0
        && (data.paymentType == 'cash' || data.paymentType == 'qr')
        && data.status == 'paid';
    }

    // A dine-in order: reserves stock like a sale but isn't paid yet. Starts
    // "pending" (needs the kitchen) or "ready" (skips straight to Expedite —
    // e.g. drinks), moves through the kitchen, and only becomes billable via
    // the sales update rule's close-bill branch.
    function validOrder(data) {
      return data.keys().hasAll(['items', 'total', 'status', 'createdAt'])
        && data.total is number
        && data.total > 0
        && (data.status == 'pending' || data.status == 'ready')
        && data.paymentType == null;
    }

    // A table's QR code only works while its session is still open — closing
    // the bill (CheckBill.tsx) flips this to false, so a stale/reused code
    // can't charge anything to an already-settled table.
    function sessionIsOpen(shopId, sessionId) {
      let path = /databases/$(database)/documents/shops/$(shopId)/tableSessions/$(sessionId);
      return exists(path) && get(path).data.status == 'open';
    }

    function validReturn(data) {
      return data.keys().hasAll([
          'productId', 'productName', 'variantSize', 'variantColor',
          'quantity', 'costPrice', 'sellingPrice', 'createdAt'
        ])
        && data.quantity is int
        && data.quantity > 0
        && data.costPrice is number
        && data.costPrice >= 0
        && data.sellingPrice is number
        && data.sellingPrice >= 0
        && data.productId is string
        && data.productName is string;
    }
  }
}
